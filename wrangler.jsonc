{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "amin-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6e15f5d4-ee9d-4a4c-ad33-d481f03fd967","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "69cc5ac9704a4faba633eebbf1f36be7" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
